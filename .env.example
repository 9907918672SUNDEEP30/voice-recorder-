# ==============================================================================
# SHAMBHAVI AI LABS - RUNTIME ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# EXECUTION_ENV स्विच:
# - 'LOCAL': इंजन 100% आपके कंप्यूटर के CPU और C:\AI_Models से काम करेगा (ज़ीरो क्लाउड कॉस्ट)।
# - 'LIGHTNING_CLOUD': भारी 4K वीडियो निर्माण लाइटनिंग AI क्लाउड GPU और /home/zeus/AI_Models से चलेगा।
EXECUTION_ENV=LOCAL

# ==============================================================================
# 1. LOCAL PATHS (आपका कंप्यूटर: Intel i3 / Windows PC / CPU & RX 550)
# ==============================================================================
# जब तक कंप्यूटर पर काम हो रहा है, यह सारे पाथ्स C:\AI_Models से लोड होंगे:
LOCAL_MODELS_DIR=C:/AI_Models
LOCAL_QWEN_PATH=C:/AI_Models/qwen2-vl-2b
LOCAL_TTS_PATH=C:/AI_Models/piper_hi
LOCAL_WHISPER_PATH=C:/AI_Models/whisper_tiny_onnx
LOCAL_AVATAR_DEFAULT=assets/avatars/default_anchor.png
LOCAL_PREVIEW_DIR=output/previews
LOCAL_CONTENT_DIR=output/omnichannel_content

# ==============================================================================
# 2. CHROME DEVTOOLS PROTOCOL (CDP - हल्का व ज़ीरो-इंस्टॉल सर्च)
# ==============================================================================
# आपके पीसी में मौजूद Google Chrome (पोर्ट 9222) से लाइव यूट्यूब और ट्रेंड रिसर्च:
CDP_HOST=127.0.0.1
CDP_PORT=9222
CDP_TIMEOUT_SECS=30

# ==============================================================================
# 3. LIGHTNING AI CLOUD CONFIGURATION (Linux Cloud GPU - SSH ब्रिज)
# ==============================================================================
# जब क्लाउड पर काम होगा, तब यह रिमोट लिनक्स पाथ्स इस्तेमाल होंगे:
LIGHTNING_SSH_HOST=lightning-ai-node
LIGHTNING_SSH_PORT=22
LIGHTNING_SSH_USER=zeus
LIGHTNING_SSH_KEY_PATH=~/.ssh/lightning_rsa
LIGHTNING_REMOTE_DIR=/home/zeus/content_engine_workspace
LIGHTNING_REMOTE_MODELS_DIR=/home/zeus/AI_Models
LIGHTNING_GPU_ACTIVE=false
LIGHTNING_POLL_INTERVAL_SECS=3
LIGHTNING_TIMEOUT_SECS=300

# ==============================================================================
# 4. DIRECT CLOUD PUBLISHING & OMNICHANNEL (क्लाउड से डायरेक्ट पब्लिश)
# ==============================================================================
DEFAULT_TOPIC="Artificial Intelligence Breakthroughs"
PUBLISH_PLATFORMS=youtube_shorts,instagram_reels,x_twitter,blog
DIRECT_CLOUD_PUBLISH=true
DOWNLOAD_PREVIEW_ONLY=true
PREVIEW_MAX_HEIGHT=360
