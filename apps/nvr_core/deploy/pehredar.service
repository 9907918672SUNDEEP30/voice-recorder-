[Unit]
Description=Shambhavi AI Labs — Pehredar Box Commercial NVR Appliance Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/shambhavi/nvr
ExecStart=/opt/shambhavi/nvr/nvr_core --config /opt/shambhavi/nvr/nvr_config.json --frames 0
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=10s

# Hardware resource guardrails (fits comfortably in 2GB RAM budget)
MemoryHigh=1200M
MemoryMax=1500M
CPUQuota=150%

# Security sandbox
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
